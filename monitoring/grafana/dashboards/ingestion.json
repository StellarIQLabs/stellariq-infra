{
  "uid": "stellariq-ingestion",
  "title": "StellarIQ — Ingestion & Indexer",
  "tags": ["stellariq", "ingestion"],
  "timezone": "utc",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Indexed ledgers (current vs chain head)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "indexer_current_ledger", "legendFormat": "indexed" },
        { "expr": "stellar_chain_head_ledger", "legendFormat": "chain head" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 2,
      "title": "Ingestion errors (15m window)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "increase(indexer_errors_total[15m])", "legendFormat": "errors" }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 10 }] } } }
    },
    {
      "id": 3,
      "title": "Indexer memory usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "process_resident_memory_bytes{job=\"indexer\"}", "legendFormat": "RSS" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 4,
      "title": "Swaps indexed per minute",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "rate(indexer_swaps_total[5m]) * 60", "legendFormat": "swaps/min" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 5,
      "title": "Pools indexed per minute",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "rate(indexer_pools_total[5m]) * 60", "legendFormat": "pools/min" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    }
  ]
}
