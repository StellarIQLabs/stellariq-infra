# StellarIQ Node base image — pinned, non-root, prod-ready.
FROM node:22.11.0-bookworm-slim AS base

ENV NODE_ENV=production \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH

RUN corepack enable && corepack prepare pnpm@9.12.3 --activate \
  && apt-get update && apt-get install -y --no-install-recommends tini ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd -r stellariq && useradd -r -g stellariq -d /app stellariq \
  && mkdir -p /app /pnpm && chown stellariq:stellariq /app /pnpm

WORKDIR /app
USER stellariq
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node"]
