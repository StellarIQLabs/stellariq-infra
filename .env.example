# StellarIQ environment template. Copy to .env and fill in. Never commit .env.
# Used by docker-compose.yml locally and mirrored by terraform + ExternalSecrets in cloud.

# --- Core ---
NODE_ENV=development
ENVIRONMENT=dev
AWS_REGION=us-east-1

# --- Postgres ---
DATABASE_URL=postgres://stellariq:stellariq@localhost:5432/stellariq
DB_HOST=localhost
DB_PORT=5432
DB_USER=stellariq
DB_PASSWORD=changeme
DB_NAME=stellariq

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Queues (localstack endpoint for local dev; real SQS URLs in cloud) ---
SQS_ENDPOINT=http://localhost:4566
SQS_INGESTION_QUEUE_URL=http://localhost:4566/000000000000/stellariq-dev-ingestion-jobs
SQS_ANALYTICS_QUEUE_URL=http://localhost:4566/000000000000/stellariq-dev-analytics-pipelines

# --- API ---
PORT=4000
API_URL=http://localhost:4000
JWT_SECRET=changeme-min-32-chars
API_KEY_SALT=changeme
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# --- Soroban / Stellar ---
SOROBAN_RPC_TESTNET=https://soroban-testnet.stellar.org
SOROBAN_RPC_MAINNET=https://soroban.stellar.org
SOROBAN_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- Data engines ---
INDEXER_CURSOR_PATH=/data/indexer-cursor.json
PRICE_ENGINE_INTERVAL_MS=15000
ANALYTICS_CRON_OHLCV=*/5 * * * *

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=
LOG_LEVEL=info

# --- Registry ---
ECR_REGISTRY=ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=local
WASM_BUCKET=stellariq-dev-contract-artifacts
